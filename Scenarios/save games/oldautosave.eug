eyr = { history = { 
		name = "6:00 October 30, 1933 : Chernomorskiy Flot has arrived in Central Black Sea." 
		name = "0:00 November 1, 1933 : Quebec entered a Military Alliance with United States." 
		name = "0:00 November 1, 1933 : Hunan entered a Military Alliance with China, Ma, Anti-Japanese Volunteer Armies, Kwangtung, Honan, Hopeh, Shensi, Shantung, Szechwan and Suiyuan." 
		name = "0:00 November 1, 1933 : Sikang entered a Military Alliance with China, Ma, Anti-Japanese Volunteer Armies, Kwangtung, Honan, Hopeh, Shensi, Shantung, Szechwan, Suiyuan and Hunan." 
		name = "0:00 November 1, 1933 : Quebec joined the war on the same side as United States in their war against Japan." 
		name = "0:00 November 1, 1933 : Hunan joined the war on the same side as China and Ma in their war against Communist China." 
		name = "0:00 November 1, 1933 : Sikang joined the war on the same side as China, Ma and Hunan in their war against Communist China." 
		name = "0:00 November 1, 1933 : Confederate States went with Samuel Longstreet/Hugo Black (Whig) in Confederate States Presidential Election, 1933." 
		name = "0:00 November 1, 1933 : Our policy can be changed." 
		name = "20:00 November 1, 1933 : Chernomorskiy Flot has arrived in Poti." 
		name = "0:00 November 2, 1933 : Japan had Offensive Chit ." 
		name = "0:00 November 5, 1933 : We concluded a diplomatic deal with Yunnan." 
		name = "0:00 November 5, 1933 : We concluded a diplomatic deal with Germany." 
		name = "0:00 November 5, 1933 : We concluded a diplomatic deal with France." 
		name = "0:00 November 5, 1933 : We concluded a diplomatic deal with Japan." 
		name = "0:00 November 6, 1933 : We concluded a diplomatic deal with Lithuania." 
		name = "0:00 November 6, 1933 : We concluded a diplomatic deal with Mongolia." 
		name = "0:00 November 6, 1933 : We concluded a diplomatic deal with Saudi Arabia." 
		name = "0:00 November 6, 1933 : We concluded a diplomatic deal with Bulgaria." 
		name = "0:00 November 6, 1933 : We concluded a diplomatic deal with Iran." 
		name = "0:00 November 6, 1933 : Confederate States had Opening of Colonial Williamsburg ." 
		name = "0:00 November 7, 1933 : We concluded a diplomatic deal with Switzerland." 
		name = "0:00 November 7, 1933 : We concluded a diplomatic deal with Kwangtung." 
		name = "0:00 November 8, 1933 : We concluded a diplomatic deal with Shensi." 
		name = "0:00 November 9, 1933 : The populace in Salla is revolting!" 
		name = "0:00 November 9, 1933 : We have lost control over Salla to Partisans." 
